          ],
          "answers": {
            "translation": 8,
            "other": 0,
            "either": 0
          }
        },
        {
          "reading": "The refund succeeds if and only if the card was verified at check-in.",
          "antecedent": "(and refund_stay_succeeded card_verified_at_check_in)",
          "consequent": "(or (not refund_stay_succeeded) (not card_verified_at_check_in))",
          "situations": [
            {
              "when": {
