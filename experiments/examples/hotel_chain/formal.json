  "background": [
    {
      "id": "F1",
      "text": "Where R1 applies and is obeyed, a part of the condition of R4 holds: If an earlier call of ask_manager was approved, then a call to ask_manager was made.",
      "formula": "(=> (and (and check_in_guest_succeeded run_has_plan) ask_manager_approved) ask_manager_called)",
      "support": "8/8",
      "between": [
        "R1",
        "R4"
      ],
      "about": "applies"
    }
  ],
  "rules": [
    {
      "id": "R1",
      "text": "WHEN a call of check_in_guest succeeds in a run with a plan THEN an earlier call of ask_manager in the run was approved",
      "trigger": "check_in_guest_succeeded",
      "status": "accepted",
      "clusters": [
        8
      ],
      "entropy": 0.0,
      "reading": "If the check-in process succeeds during a planned run, it must be the case that a manager approval was obtained earlier in that same run.",
      "antecedent": "(and check_in_guest_succeeded run_has_plan)",
      "consequent": "ask_manager_approved",
      "probes": [
        {
          "reading": "The manager approval is required only if the check-in succeeds, regardless of whether the run is planned.",
          "antecedent": "check_in_guest_succeeded",
          "consequent": "ask_manager_approved",
          "situations": [
            {
              "when": {
                "ask_manager_approved": false,
                "check_in_guest_succeeded": true,
                "run_has_plan": false
              },
              "translation_says": "obeyed"
            }
          ],
          "answers": {
            "translation": 8,
            "other": 0,
            "either": 0
          }
        },
        {
          "reading": "The manager approval is required only if the run is planned, regardless of whether the check-in succeeds.",
          "antecedent": "run_has_plan",
          "consequent": "ask_manager_approved",
          "situations": [
            {
              "when": {
                "ask_manager_approved": false,
                "check_in_guest_succeeded": false,
                "run_has_plan": true
              },
              "translation_says": "obeyed"
            }
          ],
          "answers": {
            "translation": 8,
            "other": 0,
            "either": 0
          }
        }
      ]
    },
    {
      "id": "R2",
      "text": "WHEN a call of refund_stay succeeds THEN the guest's card was verified at check-in",
      "trigger": "refund_stay_succeeded",
      "status": "accepted",
      "clusters": [
        8
      ],
      "entropy": 0.0,
      "reading": "If a refund for a stay is successfully processed, it must be the case that the guest's card was verified during the check-in process.",
      "antecedent": "refund_stay_succeeded",
      "consequent": "card_verified_at_check_in",
      "probes": [
        {
          "reading": "If the card was verified at check-in, then the refund for the stay will succeed.",
          "antecedent": "card_verified_at_check_in",
          "consequent": "refund_stay_succeeded",
          "situations": [
            {
              "when": {
                "card_verified_at_check_in": true,
