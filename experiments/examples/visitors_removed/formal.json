      "id": "F1",
      "text": "What R1 demands, in the terms of the other requirements: If a visitor initiates a check-in at a ward and is present on the patient's visitor list, the system must open the ward door.",
      "formula": "(=> (and (and visitor_checks_in visitor_on_list) (and ward_door_open badge_printed)) ward_door_open)",
      "support": "8/8",
      "restates": "R1",
      "antecedent": "(and visitor_checks_in visitor_on_list)",
      "consequent": "ward_door_open",
      "check": {
        "when": {
          "visitor_checks_in": true,
          "visitor_on_list": true,
          "ward_door_open": false
        },
        "answers": {
          "possible": 0,
          "impossible": 8,
          "unclear": 0
        },
        "verdict": "confirmed"
      }
    },
    {
      "id": "F2",
      "text": "What R2 demands, in the terms of the other requirements: When the scheduled visiting time period ends, the system must ask visitors to make room for others.",
      "formula": "(=> (and visiting_time_ends visitors_reminded_to_leave) visitor_asked_to_make_room)",
      "support": "6/8",
      "restates": "R2",
