  "rules": [
    {
      "id": "R1",
      "text": "WHEN the configuration is checked THEN shipping.max_parcels is the integer 20",
      "trigger": "configuration_checked",
      "status": "accepted",
      "clusters": [
        8
      ],
      "entropy": 0.0,
      "reading": "When the system performs a configuration check, the configured maximum number of parcels must be equal to 20.",
      "antecedent": "configuration_checked",
      "consequent": "(= max_parcels 20)",
      "probes": []
    },
    {
      "id": "R2",
      "text": "WHEN a call of ship_parcel succeeds in a run with a plan THEN an earlier call of request_signoff in the run was approved",
      "trigger": "ship_parcel_succeeded",
      "status": "accepted",
      "clusters": [
        8
      ],
      "entropy": 0.0,
      "reading": "If a ship_parcel call succeeds during a run that has a shipping plan, then a request_signoff call in that same run must have been approved previously.",
      "antecedent": "(and ship_parcel_succeeded run_has_plan)",
      "consequent": "signoff_approved_earlier",
      "probes": [
        {
          "reading": "The approval of the signoff is a precondition for the success of the ship_parcel call, meaning the success event cannot occur unless the signoff was already approved.",
          "antecedent": "ship_parcel_succeeded",
          "consequent": "signoff_approved_earlier",
          "situations": [
            {
              "when": {
                "run_has_plan": false,
                "ship_parcel_succeeded": true,
                "signoff_approved_earlier": false
