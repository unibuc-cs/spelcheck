      "consequent": "(and (= ship_parcel_call_count 1) answer_names_carrier)",
      "voted": "5/7",
      "probes": []
    },
    {
      "id": "R5",
      "text": "WHEN the same request runs while the address of k7 has no postcode THEN ship_parcel is never called AND the answer asks for the postcode",
