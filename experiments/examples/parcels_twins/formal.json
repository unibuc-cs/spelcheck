      "trigger": "signoff_refused",
      "status": "accepted",
      "clusters": [
        8
      ],
      "entropy": 0.0,
      "reading": "If a request for signoff is refused, the system must not make any subsequent calls to ship a parcel during the current run.",
      "antecedent": "signoff_refused",
      "consequent": "(not ship_parcel_called_after_refusal)",
      "probes": []
    },
    {
      "id": "R4",
      "text": "WHEN dana asks to ship parcel k7 AND the address of k7 is complete THEN ship_parcel is called once for k7 AND the answer names the carrier",
      "trigger": "ship_request_received",
      "status": "accepted",
      "clusters": [
        5,
        2
