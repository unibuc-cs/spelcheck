              "translation_says": "obeyed"
            }
          ],
          "answers": {
            "translation": 8,
            "other": 0,
            "either": 0
          }
        },
        {
          "reading": "The existence of a shipping plan is a precondition for the success of the ship_parcel call, meaning the success event cannot occur unless the run has a plan.",
          "antecedent": "ship_parcel_succeeded",
          "consequent": "run_has_plan",
          "situations": [
            {
              "when": {
                "run_has_plan": false,
                "ship_parcel_succeeded": true,
