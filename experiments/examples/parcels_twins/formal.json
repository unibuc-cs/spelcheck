          "reading": "If a ship_parcel call succeeds, then the run must have a plan AND an earlier signoff must have been approved.",
          "antecedent": "ship_parcel_succeeded",
          "consequent": "(and run_has_plan signoff_approved_earlier)",
          "situations": [
            {
              "when": {
                "run_has_plan": false,
