  "background": [
    {
      "id": "F1",
      "text": "The number of times the plan is written is never negative.",
      "formula": "(>= plan_written_count 0)",
      "support": "6/8"
    },
    {
      "id": "F2",
      "text": "The number of times ship_parcel is called for the parcel is never negative.",
      "formula": "(>= ship_parcel_called_count 0)",
      "support": "6/8"
    },
    {
      "id": "F3",
      "text": "The number of times ship_parcel succeeds is never negative.",
      "formula": "(>= ship_parcel_success_count 0)",
      "support": "6/8"
    },
    {
      "id": "F4",
      "text": "If an address has a postcode, then the address is complete.",
      "formula": "(=> address_has_postcode address_complete)",
      "support": "6/8"
    },
    {
      "id": "F5",
      "text": "What R2 demands, in the terms of the other requirements: If a parcel shipping call succeeds during a run that has a plan, it implies that a request for signoff was previously made and approved within that run.",
      "formula": "(=> (and (and ship_parcel_succeeded run_has_plan) signoff_approved_earlier) request_signoff_called)",
      "support": "8/8",
      "restates": "R2",
      "antecedent": "(and ship_parcel_succeeded run_has_plan)",
      "consequent": "request_signoff_called",
      "check": {
        "when": {
          "request_signoff_called": false,
          "run_has_plan": true,
          "ship_parcel_succeeded": true
        },
        "renames": {
          "own": {
            "signoff_approved_earlier": true
          },
          "other": {
            "request_signoff_called": false
          },
          "answers": {
            "possible": 0,
            "impossible": 8,
            "unclear": 0
          }
        },
        "answers": {
          "possible": 0,
          "impossible": 8,
          "unclear": 0
        },
        "verdict": "confirmed"
      }
    },
    {
      "id": "F6",
      "text": "What R6 demands, in the terms of the other requirements: In any execution where an express request is processed, no signoff request should be initiated.",
      "formula": "(=> (and express_request_handled (not request_signoff_called)) (not signoff_approved_earlier))",
      "support": "5/8",
      "restates": "R6",
      "antecedent": "express_request_handled",
      "consequent": "(not signoff_approved_earlier)",
      "check": {
        "when": {
          "express_request_handled": true,
          "signoff_approved_earlier": true
        },
        "renames": {
          "own": {
            "request_signoff_called": false
          },
          "other": {
            "signoff_approved_earlier": true
          },
          "answers": {
            "possible": 0,
            "impossible": 8,
            "unclear": 0
          }
        },
        "answers": {
          "possible": 0,
          "impossible": 8,
          "unclear": 0
        },
        "verdict": "confirmed"
      }
    },
    {
      "id": "F7",
      "text": "What R2 and R6 demand cannot both be the case: If a signoff request was approved earlier, the request_signoff function must have been called in the run.",
      "formula": "(not (and signoff_approved_earlier (not request_signoff_called)))",
      "support": "8/8",
      "between": [
        "R2",
        "R6"
      ]
    },
    {
      "id": "F8",
      "text": "What R4 and R7 demand cannot both be the case: A function cannot succeed three times if it is called only once.",
      "formula": "(not (and (and (= ship_parcel_called_count 1) answer_names_carrier) (and (= plan_written_count 1) (= ship_parcel_success_count 3))))",
      "support": "8/8",
      "between": [
        "R4",
        "R7"
      ]
    },
    {
      "id": "F9",
      "text": "What R7 and R9 demand cannot both be the case: A successful parcel shipment necessarily involves a change in the parcel's state.",
      "formula": "(not (and (and (= plan_written_count 1) (= ship_parcel_success_count 3)) (not parcel_state_changed)))",
      "support": "8/8",
      "between": [
        "R7",
        "R9"
      ]
    }
  ],
